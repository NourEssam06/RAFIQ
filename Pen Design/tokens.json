{
  "$description": "GSAP design tokens — Duply · https://duply.ai/gsap/design-md (v alpha)",
  "colors": {
    "ink": {
      "$value": "#fffce1",
      "$type": "color",
      "$description": "All headlines and primary text — a warm off-white cream, the dominant high-contrast foreground."
    },
    "canvas": {
      "$value": "#0e100f",
      "$type": "color",
      "$description": "The universal page floor — a warm near-black. Every band sits on this; there is no light mode in the captured surface."
    },
    "on-primary": {
      "$value": "#7c7c6f",
      "$type": "color",
      "$description": "Measured button label color — a muted olive-gray. Used as the de-emphasized text tone on the primary button element."
    },
    "accent-stone": {
      "$value": "#bbbaa6",
      "$type": "color",
      "$description": "A muted warm-gray accent — the most-frequent accent in the measure; used for secondary text and de-emphasized UI tones."
    },
    "accent-pink": {
      "$value": "#fec5fb",
      "$type": "color",
      "$description": "\"Animate Anything\" badge fill, hero gradient shape."
    },
    "accent-orange": {
      "$value": "#ff8709",
      "$type": "color",
      "$description": "SVG plugin label, hero gradient shape."
    },
    "accent-green": {
      "$value": "#0ae448",
      "$type": "color",
      "$description": "The announcement bar background and \"Get GSAP\" border glow."
    },
    "accent-violet": {
      "$value": "#9d95ff",
      "$type": "color",
      "$description": "Scroll / Text plugin labels, floating shapes."
    },
    "accent-cyan": {
      "$value": "#00bae2",
      "$type": "color",
      "$description": "UI Interactions plugin label, checkered gradient shape."
    },
    "accent-lime": {
      "$value": "#abff84",
      "$type": "color",
      "$description": "Lighter green accent, gradient transitions."
    },
    "neutral-black": {
      "$value": "#000000",
      "$type": "color",
      "$description": "Used as text-on-accent (e.g., dark labels on the green announcement bar and bright accent badges)."
    }
  },
  "typography": {
    "h1": {
      "$value": {
        "fontSize": "32px",
        "fontFamily": "Mori, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.15,
        "letterSpacing": "normal"
      },
      "$type": "typography"
    },
    "h2": {
      "$value": {
        "fontSize": "24px",
        "fontFamily": "Mori, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.15,
        "letterSpacing": "normal"
      },
      "$type": "typography"
    },
    "h3": {
      "$value": {
        "fontSize": "18.72px",
        "fontFamily": "Mori, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.15,
        "letterSpacing": "normal"
      },
      "$type": "typography"
    },
    "h4": {
      "$value": {
        "fontSize": "18px",
        "fontFamily": "Mori, sans-serif",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontSize": "14px",
        "fontFamily": "Mori, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography"
    },
    "button": {
      "$value": {
        "fontSize": "18px",
        "fontFamily": "Mori, sans-serif",
        "fontWeight": 600,
        "lineHeight": 1.05,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography"
    }
  },
  "rounded": {
    "sm": {
      "$value": "7px",
      "$type": "dimension"
    },
    "md": {
      "$value": "8px",
      "$type": "dimension"
    },
    "pill": {
      "$value": "100px",
      "$type": "dimension"
    }
  },
  "spacing": {
    "xxs": {
      "$value": "5px",
      "$type": "dimension"
    },
    "xs": {
      "$value": "7px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "base": {
      "$value": "10px",
      "$type": "dimension"
    },
    "md": {
      "$value": "16px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "18px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension"
    }
  },
  "$extensions": {
    "ai.duply": {
      "source": "https://duply.ai/gsap/design-md",
      "version": "alpha",
      "components": {
        "top-nav": {
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.canvas}"
        },
        "button-primary": {
          "padding": "16px 0px",
          "rounded": "{rounded.pill}",
          "textColor": "{colors.on-primary}",
          "typography": "{typography.button}",
          "backgroundColor": "transparent"
        },
        "button-get-gsap": {
          "padding": "16px 0px",
          "rounded": "{rounded.pill}",
          "textColor": "{colors.ink}",
          "typography": "{typography.button}",
          "backgroundColor": "transparent"
        },
        "nav-pill": {
          "rounded": "{rounded.pill}",
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "transparent"
        },
        "input": {
          "rounded": "{rounded.md}",
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.canvas}"
        },
        "hero-band": {
          "textColor": "{colors.ink}",
          "typography": "{typography.h1}",
          "backgroundColor": "{colors.canvas}"
        },
        "announcement-bar": {
          "textColor": "{colors.neutral-black}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.accent-green}"
        },
        "feature-row": {
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.canvas}"
        },
        "category-badge": {
          "rounded": "{rounded.pill}",
          "textColor": "{colors.neutral-black}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.accent-pink}"
        },
        "tag-link": {
          "rounded": "{rounded.pill}",
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "transparent"
        }
      }
    }
  }
}