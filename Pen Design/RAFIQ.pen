                  "fontSize": 24,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "SIbwe",
                  "name": "Condition",
                  "fill": "#CBC7BD",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Set up RAFIQ, start, resume or end monitoring, and review your records while stationary. If you need to use the controls yourself, wait until the vehicle is stationary.",
                  "lineHeight": 1.48,
                  "fontFamily": "DM Sans",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "UNTQR",
              "name": "During an approved supervised test",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "fdx61",
                  "name": "Section heading",
                  "fill": "#FFF7EB",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "During an approved supervised test",
                  "lineHeight": 1.2,
                  "fontFamily": "DM Sans",
                  "fontSize": 24,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "uYFlO",
                  "name": "Condition",
                  "fill": "#CBC7BD",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use RAFIQ in motion only under the institution-approved test procedure. As the driver, stay passive while the vehicle is moving. Before the test, while stationary, authorize the designated supervisor to acknowledge warnings, cancel a pending contact alert or pause monitoring on your device.",
                  "lineHeight": 1.48,
                  "fontFamily": "DM Sans",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "ziGUi",
