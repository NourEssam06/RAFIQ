                {
                  "type": "text",
                  "id": "LbS6B",
                  "name": "Section heading",
                  "fill": "#FFF7EB",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Choose separately whether to record clips",
                  "lineHeight": 1.2,
                  "fontFamily": "DM Sans",
                  "fontSize": 24,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "td5VF",
                  "name": "Condition",
                  "fill": "#CBC7BD",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The live feed is processed on your device. At session readiness, you can decline recording or opt in to video-only incident clips for selected categories. Matching clips can be saved to your private hosted storage. You can start monitoring with recording off once the other checks pass.",
                  "lineHeight": 1.48,
                  "fontFamily": "DM Sans",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
