                    },
                    {
                      "type": "text",
                      "id": "Q2qbuS",
                      "name": "Client grants",
                      "fill": "#bbbaa6",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Read driving data lets a compatible client access approved session summaries, analytics and event details. Author reports lets the client submit drafts for review in RAFIQ. You can revoke each grant independently. Revocation ends the affected access immediately. Revoking authoring can stop a report awaiting publication.",
                      "lineHeight": 1.4,
                      "fontFamily": "Space Grotesk",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "f99vP",
                      "name": "Optional chat",
                      "fill": "#bbbaa6",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Optional chat uses separate provider-by-provider linking and sharing consent. Chat sends your messages and approved driving context. Revoking chat sharing clears the temporary conversation and suppresses invalidated replies.",
                      "lineHeight": 1.4,
                      "fontFamily": "Space Grotesk",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "gzUJu",
                      "name": "Excluded data",
                      "fill": "#bbbaa6",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "MCP and chat exclude clips and links, raw media or measurement series, contacts, precise location, and finished report contents. Review provider-specific handling and consent in the chat provider settings.",
                      "lineHeight": 1.4,
                      "fontFamily": "Space Grotesk",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
