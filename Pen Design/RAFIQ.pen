          "id": "VKyog",
          "name": "Evidence boundaries",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "NGtHh",
              "name": "Behavior",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Evidence boundaries",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 21,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "M7SbZP",
              "name": "Acceptance",
              "fill": "$accent-stone",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Show timestamps, reasons, mixed counts and retry actions only when the authorized service confirms them. Byte transfer alone does not establish clip publication. Detailed incident analytics live in D07 and clip discovery and playback in D10 and D11. These fixtures illustrate proposed state contracts.",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        }
