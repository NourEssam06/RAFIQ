                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "eypUY",
                      "name": "Classification measures body",
                      "fill": "#bbbaa6",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Precision = TP / (TP + FP). Recall = TP / (TP + FN). F1 = 2TP / (2TP + FP + FN). Accuracy = (TP + TN) / scored frames. Many absent frames can raise accuracy even when detections are missed.",
                      "fontFamily": "Space Grotesk",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
