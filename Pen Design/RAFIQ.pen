            {
              "type": "frame",
              "id": "HTJ9v",
              "name": "Set up your camera at readiness",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "z5S90O",
                  "name": "Section heading",
                  "fill": "#FFF7EB",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Set up your camera at readiness",
                  "lineHeight": 1.2,
                  "fontFamily": "DM Sans",
                  "fontSize": 24,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "YvWWd",
                  "name": "Condition",
                  "fill": "#CBC7BD",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When you start a session, RAFIQ will ask to use your laptop’s built-in front-facing camera. While stationary, check the preview and position the camera so your face and upper body are visible. RAFIQ checks the view before monitoring can start.",
                  "lineHeight": 1.48,
                  "fontFamily": "DM Sans",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "W7Lcxb",
              "name": "Choose separately whether to record clips",
              "width": "fill_container",
              "layout": "vertical",
