          "children": [
            {
              "type": "text",
              "id": "dxN1a",
              "name": "Behavior",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Retry and refresh",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 21,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "Twr9r",
              "name": "Acceptance",
              "fill": "$accent-stone",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use a native button only while the operation is eligible. Mark the row Retrying… or Checking… immediately and suppress duplicate requests. Honor the service retry window. Announce the outcome once. If the button disappears, focus its row heading. Restore eligible actions after a retryable failure. Retain still-authorized content during refresh.",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "Kuf9s",
          "name": "Hairline divider",
          "fill": "#3a3d36",
          "width": "fill_container",
          "height": 1
        },
        {
          "type": "frame",
          "id": "ufQ51",
          "name": "Interrupted recovery",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "bnevG",
              "name": "Behavior",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Interrupted recovery",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 21,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "F2n8SB",
              "name": "Acceptance",
              "fill": "$accent-stone",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A close, reload or crash stops observation. Fresh, eligible online sign-in by the same driver enables replay of eligible records only. Finalize at the last durably recorded observation if known. Keep the camera off and unsent emergency actions closed. The disclosure starts collapsed after confirmation. Enter or Space expands it. If its content is being read, preserve access. If its focused target disappears, focus the summary.",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "S6fh9",
          "name": "Hairline divider",
          "fill": "#3a3d36",
          "width": "fill_container",
          "height": 1
        },
        {
          "type": "frame",
          "id": "fELFQ",
          "name": "Authorization and retention",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "tkCEz",
              "name": "Behavior",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Authorization and retention",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 21,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "xdPHR",
              "name": "Acceptance",
              "fill": "$accent-stone",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Clear private identity, times, queues and counts immediately on access loss or account switch. Route an unavailable private link to P08 (tb0lo) with Back to Sessions, a restricted account to P07 (Evx5p), or a signed-out driver to P04 (m3N6Yv). Focus the destination heading. Never retry deleted, expired or permanently ineligible data. Optional clip loss leaves authorized review usable.",
              "lineHeight": 1.35,
              "fontFamily": "Space Grotesk",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "qKziS",
          "name": "Hairline divider",
          "fill": "#3a3d36",
          "width": "fill_container",
