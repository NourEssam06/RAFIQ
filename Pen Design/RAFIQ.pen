                {
                  "type": "frame",
                  "id": "d25336a2c760",
                  "name": "Current disclosure / synthetic version 01",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "d2551695b56d",
                      "name": "Consent heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Share driving data with Aster Chat?",
                      "lineHeight": 1.38,
                      "fontFamily": "Space Grotesk",
                      "fontSize": 27,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "d255e4d5daf9",
                      "name": "Purpose",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When you send a chat message, RAFIQ sends your message and relevant data from your own eligible driving sessions to Aster Chat so it can answer your question.",
                      "lineHeight": 1.38,
                      "fontFamily": "Space Grotesk",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "d25075271f38",
                      "name": "Divider",
                      "width": "fill_container",
                      "height": 1,
                      "fill": "#383C37",
                      "layout": "vertical"
                    },
                    {
                      "type": "frame",
                      "id": "d258ebc2aab7",
                      "name": "What RAFIQ sends",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "d2522a3b1e42",
                          "name": "Section title",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "What RAFIQ sends",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 17,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "d25c78663c9a",
                          "name": "Explanation",
                          "fill": "$accent-stone",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Your messages and relevant session IDs, timestamps, duration and observation coverage. This can include behavior and incident counts, validated summary metrics with units and methods, and event IDs, behavior types, start times within a session, durations and severity.",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d25f9bba9084",
                      "name": "Data RAFIQ excludes",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "d252f0c99963",
                          "name": "Section title",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Data RAFIQ excludes",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 17,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "d250d89cba49",
                          "name": "Explanation",
                          "fill": "$accent-stone",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "RAFIQ leaves raw camera media, clips and clip links, contact details, precise location, raw measurement series, finished reports and other accounts’ data out of the driving context it adds.",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d25f777fb644",
                      "name": "Provider handling",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "d25f3ecc0b8b",
                          "name": "Section title",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "How Aster Chat handles data",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 17,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "d2583fd5ae15",
                          "name": "Synthetic provider disclosure",
                          "fill": "$accent-stone",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "In this example, Aster Chat processes your message and driving context to generate a reply. It keeps submitted data for 24 hours. Revoking RAFIQ sharing cannot recall data already sent.",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "d2506cf27e12",
                          "name": "Supplemental details trigger",
                          "width": "fill_container",
                          "gap": 10,
                          "padding": [
                            6,
                            0
                          ],
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "d25f4446148c",
                              "name": "chevron-down",
                              "width": 16,
                              "height": 16,
                              "icon": "chevron-down",
                              "library": "lucide",
                              "fill": "$accent-stone"
                            },
                            {
                              "type": "text",
                              "id": "d25660cfd176",
                              "name": "Disclosure label",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "More about Aster Chat’s data handling",
                              "lineHeight": 1.38,
                              "fontFamily": "Space Grotesk",
                              "fontSize": 15,
                              "fontWeight": "500"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "d258b8d8c20a",
                          "name": "Expanded supplemental fixture",
                          "fill": "$accent-stone",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The example retention period begins when Aster Chat receives a message. It applies separately to each message and its attached driving context.",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d25d47e441dc",
                      "name": "How to stop sharing",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "d25731cb2876",
                          "name": "Section title",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "How to stop sharing",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 17,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "d252a59e94bd",
                          "name": "Explanation",
                          "fill": "$accent-stone",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Go to Settings → Connections → Aster Chat → Revoke sharing. This stops future sharing and clears your active RAFIQ conversation. Your account stays linked. Disconnect also removes the saved connection. RAFIQ discards its temporary conversation on close or sign-out.",
                          "lineHeight": 1.38,
                          "fontFamily": "Space Grotesk",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
